# ============================================================================
# AM-TradingAgents · Command Center (Next.js) — variables de entorno
# Copia este archivo a .env.local para desarrollo local. NUNCA subas valores reales.
# En Vercel las variables NEXT_PUBLIC_SUPABASE_* y POSTGRES_* las inyecta la
# integración Vercel <-> Supabase (Marketplace).
# ============================================================================

# --- Supabase (públicas: se envían al navegador) ----------------------------
# URL del proyecto: https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Clave pública. Se acepta cualquiera de las dos; si existen ambas se usa la publishable.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# PROHIBIDO en la app web: SUPABASE_SERVICE_ROLE_KEY / secret key (solo el worker local).

# --- Migraciones en build (scripts/migrate.mjs, se ejecuta en "prebuild") ---
# Se usa la primera que exista (orden: NON_POOLING, POSTGRES_URL, SUPABASE_DB_URL). Son secretas: solo servidor/build, nunca NEXT_PUBLIC_.
POSTGRES_URL_NON_POOLING=
POSTGRES_URL=
# Si una no conecta se prueba la siguiente.
# Alternativa manual: en Supabase pulsa "Connect" y copia la cadena del
# "Session pooler" (aws-*.pooler.supabase.com:5432, usuario postgres.<ref>).
# NO uses la "Direct connection" (db.<ref>.supabase.co): en Free es solo IPv6 y
# los builds de Vercel no llegan a ella.
SUPABASE_DB_URL=

# --- Opcional ----------------------------------------------------------------
# Zona horaria IANA para mostrar fechas (por defecto Europe/Madrid).
# NEXT_PUBLIC_APP_TIME_ZONE=America/Mexico_City
